<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <display-name>Gestor Empresarial Integrado</display-name>
    
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.gestorempresarial.web.servlets.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <!-- Cliente Servlet -->
    <servlet>
        <servlet-name>ClienteServlet</servlet-name>
        <servlet-class>com.gestorempresarial.web.servlets.ClienteServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>ClienteServlet</servlet-name><url-pattern>/clientes</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ClienteServlet</servlet-name><url-pattern>/clientes/registrar</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ClienteServlet</servlet-name><url-pattern>/clientes/editar</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ClienteServlet</servlet-name><url-pattern>/clientes/eliminar</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ClienteServlet</servlet-name><url-pattern>/clientes/ver</url-pattern></servlet-mapping>
    
    <!-- Producto Servlet -->
    <servlet>
        <servlet-name>ProductoServlet</servlet-name>
        <servlet-class>com.gestorempresarial.web.servlets.ProductoServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>ProductoServlet</servlet-name><url-pattern>/productos</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ProductoServlet</servlet-name><url-pattern>/productos/registrar</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ProductoServlet</servlet-name><url-pattern>/productos/editar</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ProductoServlet</servlet-name><url-pattern>/productos/eliminar</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ProductoServlet</servlet-name><url-pattern>/productos/ver</url-pattern></servlet-mapping>
    
    <!-- Factura Servlet -->
    <servlet>
        <servlet-name>FacturaServlet</servlet-name>
        <servlet-class>com.gestorempresarial.web.servlets.FacturaServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>FacturaServlet</servlet-name><url-pattern>/facturas</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>FacturaServlet</servlet-name><url-pattern>/facturas/emitir</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>FacturaServlet</servlet-name><url-pattern>/facturas/ver</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>FacturaServlet</servlet-name><url-pattern>/facturas/anular</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>FacturaServlet</servlet-name><url-pattern>/facturas/agregar-producto</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>FacturaServlet</servlet-name><url-pattern>/facturas/eliminar-producto</url-pattern></servlet-mapping>
    
    <!-- Reporte Servlet -->
    <servlet>
        <servlet-name>ReporteServlet</servlet-name>
        <servlet-class>com.gestorempresarial.web.servlets.ReporteServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>ReporteServlet</servlet-name><url-pattern>/reportes/ventas</url-pattern></servlet-mapping>
    
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    
</web-app>